# Configure AGENT_RELAY_TOKEN with the same value as the repository Actions secret.
RUNNER_TOKEN=
RUNNER_REPOSITORY_URL=https://github.com/owner/repository
RUNNER_NAME=agent-relay-runner
RUNNER_LABELS=agent-relay
AGENT_RELAY_TOKEN=
HOST_UID=1000
HOST_GID=1000
HOST_CODEX_AUTH_FILE=/absolute/path/to/codex-auth-file
CODEX_TIMEOUT_MS=21600000
MAX_OUTPUT_BYTES=10000000

#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
  echo "codex-run must not execute as root" >&2
  exit 1
fi

umask 0077
: "${HOME:?HOME is required}"
: "${CODEX_RUNTIME_ROOT:?CODEX_RUNTIME_ROOT is required}"
: "${CODEX_BINARY:?CODEX_BINARY is required}"
: "${CODEX_HOME:?CODEX_HOME is required}"
: "${CODEX_INSTALL_ROOT:?CODEX_INSTALL_ROOT is required}"

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
toolchain_profile="${script_root}/toolchain-environment.sh"
host_config_profile="${script_root}/host-config.sh"
host_config_path="${script_root}/../config/runner-host.json"
for required_file in "${toolchain_profile}" "${host_config_profile}" "${host_config_path}"; do
  if [[ ! -f "${required_file}" || -L "${required_file}" ]]; then
    echo "Trusted runtime configuration must be a regular non-symlink file: ${required_file}" >&2
    exit 1
  fi
done
source "${toolchain_profile}"
source "${host_config_profile}"
host_config_load "${host_config_path}"
toolchain_validate_absolute_path 'Docker socket path' "${DOCKER_SOCKET_PATH}"

docker_socket_root="${DOCKER_SOCKET_PATH%/*}"
if [[ ! -d "${docker_socket_root}" || -L "${docker_socket_root}" ]]; then
  echo "Docker socket root must be a regular directory: ${docker_socket_root}" >&2
  exit 1
fi
if [[ ! -S "${DOCKER_SOCKET_PATH}" || -L "${DOCKER_SOCKET_PATH}" ]]; then
  echo "Docker socket must be a non-symlink Unix socket: ${DOCKER_SOCKET_PATH}" >&2
  exit 1
fi

for name in CODEX_BINARY CODEX_HOME CODEX_INSTALL_ROOT; do
  toolchain_validate_absolute_path "$name" "${!name}"
done
if [[ ! -d "$CODEX_INSTALL_ROOT" || -L "$CODEX_INSTALL_ROOT" \
  || "$(readlink -f -- "$CODEX_INSTALL_ROOT")" != "$CODEX_INSTALL_ROOT" ]]; then
  echo 'Codex installation must be a canonical directory' >&2
  exit 1
fi
binary="$(readlink -f -- "$CODEX_BINARY")"
if [[ "$binary" != "$CODEX_INSTALL_ROOT/"* || ! -f "$binary" || ! -x "$binary" ]]; then
  echo 'Codex executable must belong to the selected installation' >&2
  exit 1
fi
if [[ ! -d "$CODEX_HOME" || -L "$CODEX_HOME" \
  || "$(readlink -f -- "$CODEX_HOME")" != "$CODEX_HOME" \
  || "$(stat -c '%u:%a' -- "$CODEX_HOME")" != "$(id -u):700" ]]; then
  echo 'Codex home must be a private canonical directory owned by this user' >&2
  exit 1
fi
codex_auth="$CODEX_HOME/auth.json"
if [[ ! -f "$codex_auth" || -L "$codex_auth" \
  || "$(stat -c '%u:%a' -- "$codex_auth")" != "$(id -u):600" ]]; then
  echo 'Codex authentication must be a private regular file owned by this user' >&2
  exit 1
fi

mkdir -p "${CODEX_RUNTIME_ROOT}"
chmod 0700 "${CODEX_RUNTIME_ROOT}"
runtime_dir="$(mktemp -d "${CODEX_RUNTIME_ROOT}/run.XXXXXX")"
for state_directory in "${TOOLCHAIN_STATE_SUBDIRECTORIES[@]}"; do
  mkdir -m 0700 "${runtime_dir}/${state_directory}"
done
mkdir -m 0700 "${runtime_dir}/worker-run"

current_user="$(id -un)"
declare -a toolchain_env
toolchain_environment_build "${current_user}" "${HOME}" "${runtime_dir}" toolchain_env
toolchain_env+=(
  "DOCKER_HOST=unix://${DOCKER_SOCKET_PATH}"
  "TOKEN_MINIFY_RUN_LOG_DIR=${runtime_dir}/worker-run"
  "CODEX_HOME=${CODEX_HOME}"
)

child_pid=""
forward_signal() {
  trap '' TERM INT
  if [[ -n "${child_pid}" ]]; then
    kill -TERM "${child_pid}" 2>/dev/null || true
    wait "${child_pid}" 2>/dev/null || true
  fi
  exit "$1"
}
cleanup() {
  rm -rf -- "${runtime_dir}"
}
trap 'forward_signal 143' TERM
trap 'forward_signal 130' INT
trap cleanup EXIT

/usr/bin/env -i \
  "${toolchain_env[@]}" \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_OPTIONAL_LOCKS=0 \
  "$binary" "$@" &
child_pid=$!

set +e
wait "${child_pid}"
status=$?
set -e
exit "${status}"

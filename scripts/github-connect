#!/usr/bin/env bash
set -euo pipefail

SOURCE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
HOST_CONFIG_FILE=${SOURCE_ROOT}/config/runner-host.json
HOST_CONFIG_LOADER=${SOURCE_ROOT}/scripts/host-config.sh
LOCK_ROOT=/var/lib/agent-relay
LOCK_FILE=${LOCK_ROOT}/install.lock
SCRATCH_PREFIX=/tmp/agent-relay-github-connect.$$

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command is missing: $1"
}

require_regular_file() {
  local path=$1
  [[ -f "${path}" && ! -L "${path}" ]] || fail "Required regular non-symlink file is missing: ${path}"
}

sudo_stat_uid() { sudo -n stat -c '%u' -- "$1"; }
sudo_stat_mode() { sudo -n stat -c '%a' -- "$1"; }

cleanup() {
  local status=$?
  rm -f -- "${SCRATCH_PREFIX}".*
  sudo -k >/dev/null 2>&1 || true
  exit "${status}"
}
trap cleanup EXIT

runner_binary_state() {
  local -a required=(bin/Runner.Listener bin/Runner.Worker bin/runsvc.sh config.sh runsvc.sh)
  local path runner_uid mode
  runner_uid="$(id -u "${RUNNER_USER}")"
  for path in "${required[@]}"; do
    if ! sudo -n test -f "${RUNNER_DIR}/${path}" \
      || sudo -n test -L "${RUNNER_DIR}/${path}" \
      || ! sudo -n test -x "${RUNNER_DIR}/${path}"; then
      printf 'incomplete\n'
      return 0
    fi
    [[ "$(sudo_stat_uid "${RUNNER_DIR}/${path}")" == "${runner_uid}" ]] || {
      printf 'incomplete\n'
      return 0
    }
    mode="$(sudo_stat_mode "${RUNNER_DIR}/${path}")"
    if (( (8#${mode} & 8#022) != 0 )); then
      printf 'incomplete\n'
      return 0
    fi
  done
  printf 'complete\n'
}

registration_state() {
  local -a files=(.runner .credentials .credentials_rsaparams)
  local path present=0 complete=1 runner_uid mode
  runner_uid="$(id -u "${RUNNER_USER}")"
  for path in "${files[@]}"; do
    if sudo -n test -e "${RUNNER_DIR}/${path}" || sudo -n test -L "${RUNNER_DIR}/${path}"; then
      present=$((present + 1))
    fi
    if ! sudo -n test -f "${RUNNER_DIR}/${path}" || sudo -n test -L "${RUNNER_DIR}/${path}"; then
      complete=0
      continue
    fi
    mode="$(sudo_stat_mode "${RUNNER_DIR}/${path}")"
    if [[ "$(sudo_stat_uid "${RUNNER_DIR}/${path}")" != "${runner_uid}" ]] || [[ "${mode}" != "600" ]]; then
      complete=0
    fi
  done
  if (( complete == 1 )); then
    printf 'complete\n'
  elif (( present == 0 )); then
    printf 'absent\n'
  else
    printf 'partial\n'
  fi
}

listener_ready() {
  local runner_uid process_table
  runner_uid="$(id -u "${RUNNER_USER}")"
  process_table="$(ps -e -o euid=,comm=)" || return 1
  awk -v uid="${runner_uid}" '$1 == uid && $2 == "Runner.Listener" { found=1 } END { exit !found }' <<<"${process_table}"
}

if (( $# != 0 )); then
  fail "github-connect does not accept arguments"
fi
if [[ "$(id -u)" == "0" ]]; then
  fail "Run github-connect as the Ansible-created administrator, not root"
fi

require_command python3
require_regular_file "${HOST_CONFIG_FILE}"
require_regular_file "${HOST_CONFIG_LOADER}"
source "${HOST_CONFIG_LOADER}"
host_config_load "${HOST_CONFIG_FILE}" || fail "Could not load ${HOST_CONFIG_FILE}"

STORAGE_ROOT=${BASE_ROOT}/storage
EXPECTED_SOURCE_ROOT=${STORAGE_ROOT}/agent-relay
RUNNER_DIR=${STORAGE_ROOT}/runner
RUNNER_HOME=${STORAGE_ROOT}/home
SERVICE_NAME=actions.runner.${ORGANIZATION}.${RUNNER_NAME}.service
SERVICE_UNIT=/etc/systemd/system/${SERVICE_NAME}

[[ "${SOURCE_ROOT}" == "${EXPECTED_SOURCE_ROOT}" ]] || fail "The repository must be checked out at ${EXPECTED_SOURCE_ROOT}"
[[ ! -L "${SOURCE_ROOT}" ]] || fail "The source root must not be a symlink"

require_command sudo
sudo -n true || fail "The administrator requires passwordless sudo"
require_command flock
require_command curl
require_command jq
require_command ps
require_command stat

[[ -f "${LOCK_FILE}" && ! -L "${LOCK_FILE}" ]] || fail "The install lock must be a regular non-symlink file"
admin_uid="$(id -u)"
[[ "$(stat -c '%u' -- "${LOCK_FILE}")" == "${admin_uid}" ]] || fail "The administrator must own ${LOCK_FILE}"
[[ "$(stat -c '%a' -- "${LOCK_FILE}")" == "600" ]] || fail "The install lock must have mode 0600"
exec {lock_fd}<>"${LOCK_FILE}"
flock -n "${lock_fd}" || fail "Another Agent Relay installation or connection operation is active"

[[ "$(runner_binary_state)" == "complete" ]] || fail "Run ansible/playbooks/host.yml before connecting the runner to GitHub"
require_regular_file "${SOURCE_ROOT}/dist/src/run-codex.js"
sudo -n test -f "${SERVICE_UNIT}" || fail "Runner service unit is missing; run ansible/playbooks/host.yml first"
sudo -n test ! -L "${SERVICE_UNIT}" || fail "Runner service unit must not be a symlink"
[[ "$(sudo_stat_uid "${SERVICE_UNIT}")" == "0" ]] || fail "Runner service unit must be root-owned"
[[ "$(sudo_stat_mode "${SERVICE_UNIT}")" == "644" ]] || fail "Runner service unit must have mode 0644"

registration="$(registration_state)"
case "${registration}" in
  absent)
    set +x
    printf 'GitHub credential authorized to create organization runner registration tokens: ' >&2
    IFS= read -r -s github_token
    printf '\n' >&2
    [[ -n "${github_token}" ]] || fail "GitHub credential is required"
    if ! registration_response="$(
      printf 'Authorization: Bearer %s\n' "${github_token}" \
        | curl -fsSL --retry 3 -X POST \
            -H 'Accept: application/vnd.github+json' \
            -H @- \
            -H "X-GitHub-Api-Version: ${GITHUB_API_VERSION}" \
            "https://api.github.com/orgs/${ORGANIZATION}/actions/runners/registration-token"
    )"; then
      unset github_token
      fail "Could not obtain a GitHub runner registration token"
    fi
    unset github_token
    registration_token="$(jq -er '.token' <<<"${registration_response}")"
    unset registration_response
    sudo -n -u "${RUNNER_USER}" -H bash -c '
      set -euo pipefail
      umask 0077
      cd "$1"
      ./config.sh --unattended --replace --url "$2" --token "$3" --name "$4" --work _work
    ' -- "${RUNNER_DIR}" "${ORGANIZATION_URL}" "${registration_token}" "${RUNNER_NAME}"
    unset registration_token
    sudo -n -u "${RUNNER_USER}" chmod 0600 \
      "${RUNNER_DIR}/.runner" \
      "${RUNNER_DIR}/.credentials" \
      "${RUNNER_DIR}/.credentials_rsaparams"
    [[ "$(registration_state)" == "complete" ]] || fail "Runner registration did not produce the complete protected state"
    ;;
  complete) ;;
  *) fail "Runner registration is partial or conflicting; rebuild the host or remove the state deliberately" ;;
esac

sudo -n systemctl enable "${SERVICE_NAME}"
sudo -n systemctl restart "${SERVICE_NAME}"
ready=0
for _ in $(seq 1 60); do
  if sudo -n systemctl is-active --quiet "${SERVICE_NAME}" && listener_ready; then
    ready=1
    break
  fi
  sleep 1
done
(( ready == 1 )) || fail "Runner service did not become ready within 60 seconds"

printf 'Agent Relay runner is connected to GitHub: %s (%s)\n' "${RUNNER_NAME}" "${ORGANIZATION_URL}"

#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
  echo "codex-run must not execute as root" >&2
  exit 1
fi

umask 0077
: "${HOME:?HOME is required}"
: "${CODEX_RUNTIME_ROOT:?CODEX_RUNTIME_ROOT is required}"

codex_auth="${HOME}/.codex/auth.json"
if [[ ! -f "${codex_auth}" ]]; then
  echo "Codex authentication is missing; run codex login" >&2
  exit 1
fi

mkdir -p "${CODEX_RUNTIME_ROOT}"
chmod 0700 "${CODEX_RUNTIME_ROOT}"
runtime_dir="$(mktemp -d "${CODEX_RUNTIME_ROOT}/run.XXXXXX")"
mkdir -m 0700 \
  "${runtime_dir}/cache" \
  "${runtime_dir}/cargo" \
  "${runtime_dir}/config" \
  "${runtime_dir}/data" \
  "${runtime_dir}/go" \
  "${runtime_dir}/go-cache" \
  "${runtime_dir}/gradle" \
  "${runtime_dir}/npm" \
  "${runtime_dir}/pip" \
  "${runtime_dir}/tmp"

child_pid=""
forward_signal() {
  if [[ -n "${child_pid}" ]]; then
    kill -TERM "${child_pid}" 2>/dev/null || true
  fi
}
cleanup() {
  rm -rf -- "${runtime_dir}"
}
trap forward_signal TERM INT
trap cleanup EXIT

current_user="$(id -un)"
/usr/bin/env -i \
  HOME="${HOME}" \
  USER="${current_user}" \
  LOGNAME="${current_user}" \
  SHELL=/bin/bash \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  JAVA_HOME=/opt/java/openjdk \
  CARGO_HOME="${runtime_dir}/cargo" \
  RUSTUP_HOME=/opt/rust/rustup \
  GOPATH="${runtime_dir}/go" \
  GOCACHE="${runtime_dir}/go-cache" \
  NPM_CONFIG_CACHE="${runtime_dir}/npm" \
  PIP_CACHE_DIR="${runtime_dir}/pip" \
  GRADLE_USER_HOME="${runtime_dir}/gradle" \
  XDG_CACHE_HOME="${runtime_dir}/cache" \
  XDG_CONFIG_HOME="${runtime_dir}/config" \
  XDG_DATA_HOME="${runtime_dir}/data" \
  GIT_CONFIG_GLOBAL=/dev/null \
  TMPDIR="${runtime_dir}/tmp" \
  TMP="${runtime_dir}/tmp" \
  TEMP="${runtime_dir}/tmp" \
  GIT_OPTIONAL_LOCKS=0 \
  PATH=/opt/java/openjdk/bin:/usr/local/go/bin:/opt/rust/cargo/bin:/usr/local/bin:/usr/bin:/bin \
  /usr/local/bin/codex "$@" &
child_pid=$!

set +e
wait "${child_pid}"
status=$?
set -e
exit "${status}"

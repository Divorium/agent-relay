#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -un)" != "agent" ]]; then
  echo "codex-run must execute as the isolated agent user" >&2
  exit 1
fi

umask 0077
agent_home=/home/agent
codex_home="$agent_home/.codex"
mkdir -p "$codex_home"
find "$agent_home" -mindepth 1 -maxdepth 1 \
  ! -name .cargo \
  ! -name .rustup \
  ! -name .codex \
  -exec rm -rf -- {} +
find "$codex_home" -mindepth 1 -maxdepth 1 ! -name auth.json -exec rm -rf -- {} +

exec /usr/bin/env -i \
  HOME=/home/agent \
  USER=agent \
  LOGNAME=agent \
  SHELL=/bin/bash \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  JAVA_HOME=/opt/java/openjdk \
  CARGO_HOME=/home/agent/.cargo \
  RUSTUP_HOME=/home/agent/.rustup \
  PATH=/opt/java/openjdk/bin:/usr/local/go/bin:/home/agent/.cargo/bin:/usr/local/bin:/usr/bin:/bin \
  /usr/local/bin/codex "$@"

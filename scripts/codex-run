#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == "0" ]]; then
  echo "codex-run must not execute as root" >&2
  exit 1
fi

umask 0077
: "${HOME:?HOME is required}"
: "${CODEX_RUNTIME_ROOT:?CODEX_RUNTIME_ROOT is required}"

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
toolchain_profile="${script_root}/toolchain-environment.sh"
host_config_profile="${script_root}/host-config.sh"
host_config_path="${script_root}/../config/runner-host.json"
for required_file in "${toolchain_profile}" "${host_config_profile}" "${host_config_path}"; do
  if [[ ! -f "${required_file}" || -L "${required_file}" ]]; then
    echo "Trusted runtime configuration must be a regular non-symlink file: ${required_file}" >&2
    exit 1
  fi
done
source "${toolchain_profile}"
source "${host_config_profile}"
host_config_load "${host_config_path}"
toolchain_validate_absolute_path 'Docker socket path' "${DOCKER_SOCKET_PATH}"

docker_socket_root="${DOCKER_SOCKET_PATH%/*}"
if [[ ! -d "${docker_socket_root}" || -L "${docker_socket_root}" ]]; then
  echo "Docker socket root must be a regular directory: ${docker_socket_root}" >&2
  exit 1
fi
if [[ ! -S "${DOCKER_SOCKET_PATH}" || -L "${DOCKER_SOCKET_PATH}" ]]; then
  echo "Docker socket must be a non-symlink Unix socket: ${DOCKER_SOCKET_PATH}" >&2
  exit 1
fi

codex_auth="${HOME}/.codex/auth.json"
if [[ ! -f "${codex_auth}" ]]; then
  echo "Codex authentication is missing; run codex login" >&2
  exit 1
fi

mkdir -p "${CODEX_RUNTIME_ROOT}"
chmod 0700 "${CODEX_RUNTIME_ROOT}"
runtime_dir="$(mktemp -d "${CODEX_RUNTIME_ROOT}/run.XXXXXX")"
for state_directory in "${TOOLCHAIN_STATE_SUBDIRECTORIES[@]}"; do
  mkdir -m 0700 "${runtime_dir}/${state_directory}"
done

current_user="$(id -un)"
declare -a toolchain_env
toolchain_environment_build "${current_user}" "${HOME}" "${runtime_dir}" toolchain_env
toolchain_env+=("DOCKER_HOST=unix://${DOCKER_SOCKET_PATH}")

child_pid=""
forward_signal() {
  if [[ -n "${child_pid}" ]]; then
    kill -TERM "${child_pid}" 2>/dev/null || true
  fi
}
cleanup() {
  rm -rf -- "${runtime_dir}"
}
trap forward_signal TERM INT
trap cleanup EXIT

/usr/bin/env -i \
  "${toolchain_env[@]}" \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_OPTIONAL_LOCKS=0 \
  /usr/local/bin/codex "$@" &
child_pid=$!

set +e
wait "${child_pid}"
status=$?
set -e
exit "${status}"

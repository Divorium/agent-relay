{
  "name": "agent-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:runner-entrypoint": "bash test/runner-entrypoint.test.sh",
    "start": "node dist/src/server.js",
    "check": "npm run typecheck && npm test && npm run test:runner-entrypoint"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
